{
  "expo": {
    "name": "ClubHub",
    "slug": "clubhub-mobile",
    "version": "0.1.0",
    "scheme": "clubhub",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF9"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "africa.clubhub.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "africa.clubhub.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ClubHub uses your camera to scan event check-in QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ClubHub uses your photo library to set your profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
